# Student Academic Performance & University Result Analyzer - Backend Environment
# Copy this file to .env and provide your actual Supabase credentials.

# Application Server Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (Obtain from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Buckets (will be auto-created if using migration script)
SUPABASE_BUCKET_RESULTS=university-results
SUPABASE_BUCKET_MARKS=ia-marksheets

# ---- Student OTP sign-in (register number + e-mail -> one-time password) ----
# Length of the generated numeric code and its lifetime / resend cooldown.
STUDENT_OTP_LENGTH=4
STUDENT_OTP_TTL_SECONDS=300
STUDENT_OTP_RESEND_COOLDOWN_SECONDS=45
STUDENT_OTP_MAX_ATTEMPTS=5
# Fixed code used for the local demo walkthrough (defaults to 1234 in development).
# Leave EMPTY in production so random one-time codes are issued instead.
STUDENT_OTP_FIXED=1234

# ---- SMTP (delivers the OTP to the student mailbox) ----
# Leave these blank to run in development mode, where the API returns the
# generated code in its response (and the UI displays it on screen).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@academic-analyzer.edu
SMTP_USE_TLS=true

